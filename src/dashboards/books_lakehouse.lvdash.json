{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPI summary",
      "queryLines": [
        "SELECT * FROM books.gold.v_kpi_summary"
      ]
    },
    {
      "name": "ds_top_books",
      "displayName": "Top 10 books all-time",
      "queryLines": [
        "SELECT title, author, ratings_cnt, avg_rating, weighted_rating \n",
        "FROM books.gold.v_books \n",
        "ORDER BY weighted_rating DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_popular",
      "displayName": "Most popular books",
      "queryLines": [
        "SELECT title, author, readers_total, ratings_cnt, avg_rating \n",
        "FROM books.gold.v_books \n",
        "ORDER BY readers_total DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_top_authors",
      "displayName": "Top 10 authors",
      "queryLines": [
        "SELECT author, ratings_cnt, avg_rating, weighted_rating \n",
        "FROM books.gold.v_authors \n",
        "WHERE ratings_cnt >= 25 \n",
        "ORDER BY weighted_rating DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "Avg rating by publication year",
      "queryLines": [
        "SELECT year_of_publication, avg_rating, ratings_cnt \n",
        "FROM books.gold.v_avg_rating_by_year \n",
        "WHERE ratings_cnt >= 50 AND year_of_publication BETWEEN 1950 AND 2004 \n",
        "ORDER BY year_of_publication"
      ]
    },
    {
      "name": "ds_top_by_period",
      "displayName": "Top 10 books by period",
      "queryLines": [
        "SELECT title, author, year_of_publication, ratings_cnt, weighted_rating \n",
        "FROM books.gold.v_books \n",
        "WHERE year_of_publication BETWEEN :year_range.min AND :year_range.max \n",
        "ORDER BY weighted_rating DESC LIMIT 10"
      ],
      "parameters": [
        {
          "keyword": "year_range",
          "displayName": "Rok vydání",
          "dataType": "INTEGER",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "INTEGER",
              "min": {
                "value": "1990"
              },
              "max": {
                "value": "2004"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_genres",
      "displayName": "Genre picker options",
      "queryLines": [
        "SELECT genre, SUM(ratings_cnt) AS cnt \n",
        "FROM books.gold.v_books_by_genre \n",
        "GROUP BY genre ORDER BY cnt DESC LIMIT 100"
      ]
    },
    {
      "name": "ds_top_by_genre",
      "displayName": "Top 10 books in genre",
      "queryLines": [
        "SELECT genre, title, author, ratings_cnt, weighted_rating \n",
        "FROM books.gold.v_books_by_genre \n",
        "WHERE genre = :genre \n",
        "ORDER BY weighted_rating DESC LIMIT 10"
      ],
      "parameters": [
        {
          "keyword": "genre",
          "displayName": "Žánr",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Fiction"
                }
              ]
            }
          }
        }
      ]
    }
  ],
